# Copy to .env if you want to change the local defaults. Never commit real keys.
PROVIDER=ollama
MODEL=llama3.2
TEMPERATURE=0.2
MAX_STEPS=5
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RATES_URL=https://open.er-api.com/v6/latest
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Cloud providers additionally need their own integration package and API key.
